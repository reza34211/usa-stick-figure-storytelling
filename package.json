{
  "name": "usa-stick-figure-storytelling",
  "version": "1.0.0",
  "private": true,
  "description": "2D Stick Figure Animation (Remotion). Visual-first; voiceover and subtitles added later.",
  "scripts": {
    "start": "remotion studio --port 3000",
    "typecheck": "tsc --noEmit",
    "preview": "remotion render Main out/preview.mp4 --codec=h264 --scale=0.5 --crf=28",
    "render": "remotion render Main out/final.mp4 --codec=h264 --crf=18",
    "still": "remotion still Main out/frame.png --frame=30"
  },
  "dependencies": {
    "@remotion/cli": "4.0.250",
    "@remotion/transitions": "4.0.250",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.250"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "typescript": "^5.4.0"
  }
}
